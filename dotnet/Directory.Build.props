<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet package metadata -->
    <Version>0.6.0-dev</Version>
    <Authors>Oxigraph Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/oxigraph/oxigraph</PackageProjectUrl>
    <RepositoryUrl>https://github.com/oxigraph/oxigraph</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>RDF;SPARQL;Graph;Database;SemanticWeb</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>
